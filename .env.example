# ===========================================================================
# AI 量化交易守门员 - 环境变量样例
# 复制为 .env 后填写。.env 已在 .gitignore 中，禁止提交。
# ===========================================================================

# --- OKX 凭证：只允许执行域使用；不进入 LLM 上下文、不写日志 ---------------
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# OKX 模拟盘（dry-run）建议为 true 直到 P4
OKX_DEMO_TRADING=true

# --- OKX 只读 MCP / 交易 CLI ----------------------------------------------
OKX_MCP_READONLY_CMD="okx-trade-mcp --read-only"
OKX_CLI_CMD="okx-trade-cli"
CLI_TIMEOUT_SEC=10
# true: MCP 二进制缺失也算自检失败（生产建议 true；本地无 MCP 时置 false）
READONLY_CHECK_REQUIRED=true

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- 标签服务 -------------------------------------------------------------
LABEL_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT
LABEL_TTL_SEC=300
LABEL_CYCLE_SEC=60
LABEL_HEARTBEAT_SEC=30
LABEL_HEARTBEAT_TTL_SEC=60

# --- LLM（锁定 SDK 版本、通过环境变量配置、禁止硬编码）--------------------
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SEC=30

# --- 外部新闻/情绪源（可选，未配置不阻塞主流程）----------------------------
NEWS_ENABLED=false
NEWS_PROVIDER=cryptopanic
NEWS_API_URL=https://cryptopanic.com/api/v1/posts/
NEWS_API_TOKEN=
NEWS_TIMEOUT_SEC=10

# --- 闸门 ---------------------------------------------------------------
GATE_ENABLED=true
# 必须为 true：标签缺失/异常一律放行
GATE_FAIL_OPEN=true
# 交易所最小下单量兜底（JSON），键为交易对
GATE_MIN_AMOUNT_JSON={"BTC/USDT":0.0001,"ETH/USDT":0.001,"SOL/USDT":0.01}

# --- 守门服务 fail-closed ------------------------------------------------
GATE_HOST=0.0.0.0
GATE_PORT=8080
GATE_API_TOKEN=change-me-gate-token
LABEL_SERVICE_URL=http://label-service:8081
FREQTRADE_API_URL=http://freqtrade:8080
FREQTRADE_API_USER=freqtrader
FREQTRADE_API_PASSWORD=change-me-ft-password

# --- 验证模块（P2）------------------------------------------------------
WFA_EMBARGO_BARS=24
WFA_TRAIN_BARS=2016
WFA_TEST_BARS=504
WFA_STEP_BARS=504
APPROVE_SHARPE_DELTA=0.1
APPROVE_MDD_REDUCTION=0.10
APPROVE_MAX_TRADE_DROP=0.30
APPROVE_CATASTROPHE_MULT=1.5

# --- 审计 ---------------------------------------------------------------
AUDIT_LOG_DIR=./logs
AUDIT_RETENTION_DAYS=180

# --- 日志 --------------------------------------------------------------
LOG_LEVEL=INFO
